// Separate Node class defined outside the main class
class Node {
    int val;
    Node next;

    Node(int val) {
        this.val = val;
        this.next = null;
    }
}

// Main Queue class
public class Main {
    
    // Class-level variables (declared outside all methods)
    private Node head = null;
    private Node tail = null;
    private int size = 0;

    // Add element to the end of the queue (Enqueue)
    public void add(int val) {
        Node t = new Node(val);
        if (size == 0) {
            head = t;
            tail = t;
        } else {
            tail.next = t;
            tail = t;
        }
        size++;
    }

    // Remove element from the front of the queue (Dequeue)
    public int remove() {
        if (size == 0) {
            System.out.println("Queue is empty");
            return -1;
        }
        int removedVal = head.val;
        head = head.next;
        size--;

        if (size == 0) {
            tail = null;
        }

        return removedVal;
    }

    // Peek at the front element
    public int peek() {
        if (size == 0) {
            System.out.println("Queue is empty");
            return -1;
        }
        return head.val;
    }

    // Get size
    public int getSize() {
        return size;
    }

    // Check if empty
    public boolean isEmpty() {
        return size == 0;
    }

    // Display elements
    public void display() {
        if (size == 0) {
            System.out.println("Queue is empty");
            return;
        }
        Node temp = head;
        System.out.print("Queue contents: ");
        while (temp != null) {
            System.out.print(temp.val + " ");
            temp = temp.next;
        }
        System.out.println();
    }

    // Main execution method
    public static void main(String[] args) {
        Main queue = new Main();

        queue.add(10);
        queue.add(20);
        queue.add(30);

        queue.display(); // Output: Queue contents: 10 20 30

        System.out.println("Removed: " + queue.remove());    // Output: 10
        System.out.println("Front element: " + queue.peek()); // Output: 20

        queue.display(); // Output: Queue contents: 20 30
    }
}
